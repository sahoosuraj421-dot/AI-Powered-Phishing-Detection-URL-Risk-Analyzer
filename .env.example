# ─── Environment Template ──────────────────────────────────────────────────
# Copy this file to .env and insert your real values.
# NEVER commit your real .env file with secrets to version control.

# Hugging Face (Qwen LLM) - Optional: offline advisory mode operates if left blank
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# JWT Secret - generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Database
DATABASE_URL=sqlite:///./phishing.db

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting (true/false)
RATE_LIMITING_ENABLED=true

# ─── Threat Intelligence APIs (Optional) ──────────────────────────────────────
# Free key from https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# Key from Google Cloud Console (Safe Browsing API)
GOOGLE_SAFE_BROWSING_KEY=
